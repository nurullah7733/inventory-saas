# Neon PostgreSQL connection string.
# Use the POOLED endpoint (host contains "-pooler") for the app runtime.
# Copy this file to `.env` and fill in real values — `.env` is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Runtime connection — the one the APPLICATION uses (prisma/db.ts prefers it).
#
# Why a second URL: tenant isolation is enforced twice, once by the query
# filters in lib/tenant/scope.ts and once by the PostgreSQL row-level security
# policies in prisma/contract.prisma. Postgres skips those policies entirely
# for a role holding the BYPASSRLS attribute, and Neon creates its owner role
# (the one in DATABASE_URL above) with it. Removing that attribute needs
# superuser, which Neon does not grant — so the app connects as a separate,
# unprivileged role instead, while migrations keep using the owner.
#
# Create or refresh that role, and write this line, with:
#   npm run db:app-role -- --write-env
#
# The command is idempotent; run it again after a migration that adds tables if
# the new tables ever come back "permission denied". Set the same variable in
# the deployment environment (Vercel) — with DATABASE_URL present but this one
# missing, the app still runs, logs a warning, and falls back to the owner
# role, which means RLS silently stops enforcing anything.
APP_DATABASE_URL="postgresql://app_runtime:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth -------------------------------------------------------------------

# HMAC key that signs access tokens (HS256). REQUIRED — the API refuses to
# authenticate anything without it. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every access token in circulation; clients
# recover automatically by calling /api/v1/auth/refresh, since refresh tokens
# are database rows and are not signed with it.
JWT_SECRET=""

# `iss` / `aud` claims. Give staging and production different values so a token
# minted for one environment is rejected by the other even if a secret leaks
# across. Optional — sensible defaults are used when unset.
# JWT_ISSUER="inventory-saas"
# JWT_AUDIENCE="inventory-saas-api"

# Access-token lifetime, in seconds (default 900 = 15 minutes). This is the
# window during which a deactivated user or suspended tenant could still be
# admitted by an already-issued token, so keep it short.
# ACCESS_TOKEN_TTL_SECONDS="900"

# Refresh-token lifetime, in seconds (default 2592000 = 30 days). Longer is
# safe here: refresh tokens are stored hashed and can be revoked instantly.
# REFRESH_TOKEN_TTL_SECONDS="2592000"

# bcrypt work factor (default 12). Higher is slower to attack AND slower to log
# in — raise it as hardware improves, but measure first.
# BCRYPT_ROUNDS="12"

# --- Image uploads ----------------------------------------------------------

# Product, business logo, shop owner, and category photos (POST /api/v1/uploads/images).
#
# With this token set, images go to Vercel Blob and are served from its CDN —
# the production setup on Vercel. Create a Blob store in the Vercel dashboard
# (Storage → Blob) and it adds this variable to the project for you.
#
# Without it, images are written to LOCAL_UPLOAD_DIR on this machine and served
# back by /media/... — fine for development or a self-hosted server with a
# persistent disk. On Vercel without the token, uploads are refused (503),
# because a serverless function has no disk that survives the request.
# BLOB_READ_WRITE_TOKEN=""

# Where the local driver keeps files (default: .uploads, gitignored).
# LOCAL_UPLOAD_DIR=".uploads"


# vercel blob storage (but need to config blob storage in app project)
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
# --- Stripe subscription billing --------------------------------------------
# Use test-mode keys/prices while developing; never expose these as NEXT_PUBLIC.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_BASIC_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
# Trusted site origin used for Stripe return URLs; no user-supplied redirects.
APP_URL="http://localhost:3000"
# Configure flat recurring licensed prices, quantity 1, in the SAME currency.
# Defaults below match the initial trial limits and a larger Pro tier.
BILLING_BASIC_MAX_PRODUCTS="100"
BILLING_BASIC_MAX_STAFF="5"
BILLING_PRO_MAX_PRODUCTS="1000"
BILLING_PRO_MAX_STAFF="20"

# Email verification: production uses Resend; file transport is development-only.
EMAIL_TRANSPORT="file"
RESEND_API_KEY=""
EMAIL_FROM="Inventory <verify@example.com>"
# APP_URL above must be your HTTPS application origin in production.
