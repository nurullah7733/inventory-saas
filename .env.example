# Neon PostgreSQL connection string.
# Use the POOLED endpoint (host contains "-pooler") for the app runtime.
# Copy this file to `.env` and fill in real values — `.env` is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

APP_DATABASE_URL="postgresql://app_runtime:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

JWT_SECRET=""

BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# --- bKash subscription payments (server-only) -----------------------
BKASH_ENV="sandbox"
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""

# Positive BDT prices. Annual payments buy 12 calendar months.
BILLING_BASIC_PRICE_BDT="1000"
BILLING_BASIC_YEARLY_PRICE_BDT="10000"
BILLING_PRO_PRICE_BDT="2000"
BILLING_PRO_YEARLY_PRICE_BDT="20000"


# Public HTTPS origin for callbacks; localhost is allowed only for sandbox development.
APP_URL="http://localhost:3000"

BILLING_BASIC_MAX_PRODUCTS="100"
BILLING_BASIC_MAX_STAFF="5"
BILLING_PRO_MAX_PRODUCTS="1000"
BILLING_PRO_MAX_STAFF="20"

# Email verification: production uses Resend; file transport is development-only.
EMAIL_TRANSPORT="file"
RESEND_API_KEY=""
EMAIL_FROM="Inventory <verify@example.com>"
# APP_URL above must be your HTTPS application origin in production.
