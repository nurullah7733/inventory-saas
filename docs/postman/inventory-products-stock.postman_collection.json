{
  "info": {
    "name": "Inventory SaaS — Products, Suppliers & Stock",
    "description": "Step 7 of the build order: Products (soft delete, variant selects, expiry, image upload), Suppliers, Add Stock, Wastage, and the Low Stock / Near-Expiry alert views.\n\nHow to use:\n1. Set `baseUrl`, `email` and `password` (Collection → Variables).\n2. Run **Auth → Login**; the access token is saved to `accessToken`.\n3. Create requests save the new id (`productId`, `supplierId`, `imageUrl`), so the requests after them work straight away.\n\nRoles: owner and manager edit products and suppliers; every role (staff included) can add stock and record wastage.\n\nMoney is sent and returned as decimal strings (\"1450.50\"). Stock quantity is never set directly — only Add Stock and Wastage move it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "email",
      "value": "owner@example.com"
    },
    {
      "key": "password",
      "value": "your-password"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "colorId",
      "value": ""
    },
    {
      "key": "imageUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.ok) {",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  console.log('Logged in as', body.data.user.email, '(' + body.data.user.role + ')');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"postman\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Saves `accessToken` for every other request in this collection."
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload product image",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/uploads/images",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "purpose",
                  "value": "product",
                  "type": "text"
                }
              ]
            },
            "description": "multipart/form-data. `file`: JPEG, PNG or WebP up to 5 MB (checked by content, not by name). Saves the returned URL as `imageUrl`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.ok) pm.collectionVariables.set('imageUrl', body.data.image.url);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "List suppliers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/suppliers?status=all&search=",
            "description": "`status` = all | active | inactive. Each supplier includes `stockEntryCount` and `paymentCount`."
          }
        },
        {
          "name": "Create supplier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/suppliers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Traders\",\n  \"phone\": \"+880 1711-000000\",\n  \"address\": \"Chawkbazar, Dhaka\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.ok) pm.collectionVariables.set('supplierId', body.data.supplier.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get supplier",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/suppliers/{{supplierId}}"
          }
        },
        {
          "name": "Update supplier",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/suppliers/{{supplierId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+880 1811-111111\"\n}"
            }
          }
        },
        {
          "name": "Mark supplier inactive",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/suppliers/{{supplierId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "description": "Hidden from the Add Stock dropdown; history kept. Send `true` to reactivate."
          }
        },
        {
          "name": "Delete supplier",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/suppliers/{{supplierId}}",
            "description": "Only when no stock entry or payment references it — otherwise 409 with the counts."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?search=&status=active&page=1&pageSize=20",
            "description": "`status` = active | deleted | all. `search` matches name or SKU. Optional `categoryId`."
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Runner Pro\",\n  \"sku\": \"RN-001\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"colorId\": \"{{colorId}}\",\n  \"unitId\": null,\n  \"sizeId\": null,\n  \"weightId\": null,\n  \"brand\": \"Acme\",\n  \"expiryDate\": null,\n  \"costPrice\": \"1000\",\n  \"sellPrice\": \"1450.50\",\n  \"imageUrl\": \"{{imageUrl}}\",\n  \"attributes\": {\n    \"warranty_months\": 6,\n    \"material\": \"Leather\"\n  }\n}"
            },
            "description": "Leave `sku` blank to generate one. Category / variant ids must belong to your shop (and the category must be active). Fails with 403 PLAN_LIMIT_REACHED at the plan's product limit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.ok) pm.collectionVariables.set('productId', body.data.product.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellPrice\": \"1500\",\n  \"expiryDate\": \"2027-03-31\"\n}"
            }
          }
        },
        {
          "name": "Delete product (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Sets is_deleted = true. History stays; the product leaves lists, pickers and alerts."
          }
        },
        {
          "name": "Restore product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDeleted\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Stock",
      "item": [
        {
          "name": "List stock entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/stock-movements?type=in&page=1&pageSize=20",
            "description": "`type` = in | out | adjustment | return | wastage | all. Optional `productId`, `supplierId`, `from` / `to` (ISO timestamps). `quantity` is signed: + adds stock, − removes it."
          }
        },
        {
          "name": "Add stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/stock-movements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"supplierId\": \"{{supplierId}}\",\n  \"quantity\": 24,\n  \"unitCost\": \"950\",\n  \"receivedAt\": null,\n  \"note\": \"Invoice #1042\",\n  \"updateCostPrice\": false\n}"
            },
            "description": "`receivedAt` (optional ISO timestamp) back-dates the entry; never in the future. `updateCostPrice: true` also sets the product's cost price to `unitCost`."
          }
        }
      ]
    },
    {
      "name": "Wastage",
      "item": [
        {
          "name": "List wastage",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wastage?page=1&pageSize=20",
            "description": "Includes `totalLoss` across every matching row."
          }
        },
        {
          "name": "Record wastage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wastage",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2,\n  \"reason\": \"Damaged\"\n}"
            },
            "description": "Loss = quantity × the product's current cost price, computed by the server. 409 INSUFFICIENT_STOCK if more than is in stock."
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "Low stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/alerts/low-stock?search=",
            "description": "Defaults to the shop's Business Settings threshold; override with `threshold=`."
          }
        },
        {
          "name": "Near expiry",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/alerts/near-expiry?days=30&asOf=",
            "description": "Expired and expiring within `days` of `asOf` (YYYY-MM-DD — send the device's local date). `includeEmpty=true` adds products with no stock."
          }
        }
      ]
    }
  ]
}