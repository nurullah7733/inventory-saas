{
  "info": {
    "name": "Inventory SaaS — Variants & Categories",
    "description": "Step 6 of the build order: Variant master lists (colors, sizes, weights, units) and Categories CRUD.\n\nHow to use:\n1. Set the collection variables `baseUrl`, `email` and `password` (Collection → Variables).\n2. Run **Auth → Login**. The access token is saved to `accessToken` automatically and every other request sends it as `Authorization: Bearer ...`.\n3. Create requests save the new id (`variantId`, `categoryId`), so Get / Update / Delete work straight after.\n\nChange `kind` to `colors`, `sizes`, `weights` or `units` to switch variant lists.\n\nThe access token lives 15 minutes — run Login again if you get 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "email", "value": "owner@example.com" },
    { "key": "password", "value": "your-password" },
    { "key": "accessToken", "value": "" },
    { "key": "kind", "value": "colors" },
    { "key": "variantId", "value": "" },
    { "key": "categoryId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.ok) {",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  console.log('Logged in as', body.data.user.email, '(' + body.data.user.role + ')');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"postman\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Saves `accessToken` for every other request in this collection."
          }
        }
      ]
    },
    {
      "name": "Variants",
      "description": "`{{kind}}` = colors | sizes | weights | units. Owner and manager can write; staff can only read.",
      "item": [
        {
          "name": "List options",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/variants/{{kind}}",
            "description": "All options of one list, A→Z, each with `productCount`."
          }
        },
        {
          "name": "Create option",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.ok) pm.collectionVariables.set('variantId', body.data.option.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Black\"\n}" },
            "url": "{{baseUrl}}/variants/{{kind}}",
            "description": "Saves the new id to `variantId`. A case-insensitive duplicate name returns 409."
          }
        },
        {
          "name": "Get option",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/variants/{{kind}}/{{variantId}}"
          }
        },
        {
          "name": "Rename option",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jet Black\"\n}" },
            "url": "{{baseUrl}}/variants/{{kind}}/{{variantId}}"
          }
        },
        {
          "name": "Delete option",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/variants/{{kind}}/{{variantId}}",
            "description": "Returns 409 with the product count if any product (including soft-deleted) still uses this option."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "description": "Owner and manager can write; staff can only read.",
      "item": [
        {
          "name": "List categories (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories?status=all",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [
                {
                  "key": "status",
                  "value": "all",
                  "description": "all | active | archived (default: all)"
                }
              ]
            }
          }
        },
        {
          "name": "List categories (active only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories?status=active",
              "host": ["{{baseUrl}}"],
              "path": ["categories"],
              "query": [{ "key": "status", "value": "active" }]
            },
            "description": "What the product form's category dropdown will use."
          }
        },
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.ok) pm.collectionVariables.set('categoryId', body.data.category.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sneakers\",\n  \"imageUrl\": \"https://example.com/sneakers.jpg\"\n}"
            },
            "url": "{{baseUrl}}/categories",
            "description": "`imageUrl` is optional (omit it, or send null / \"\"). Saves the new id to `categoryId`."
          }
        },
        {
          "name": "Get category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Running Shoes\",\n  \"imageUrl\": null\n}"
            },
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "description": "Send any of `name`, `imageUrl`, `isActive`. The response lists which fields `changed`."
          }
        },
        {
          "name": "Archive category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "Restore category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "description": "Returns 409 with the product count if the category still has products — archive it instead."
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "No token → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/variants/colors"
          }
        },
        {
          "name": "Unknown variant kind → 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/variants/flavours"
          }
        },
        {
          "name": "Blank name → 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"   \"\n}" },
            "url": "{{baseUrl}}/variants/{{kind}}"
          }
        },
        {
          "name": "tenantId in body → 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Boots\",\n  \"tenantId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "javascript: image URL → 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Image\",\n  \"imageUrl\": \"javascript:alert(1)\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        }
      ]
    }
  ]
}
